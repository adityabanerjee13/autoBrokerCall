MONGO_URI=mongodb://localhost:27017
MONGO_DB=brokeragent

# Azure AI Foundry - the model behind everything this app still decides:
# the post-call grading (LLM-2a/2b), the memory compactor (LLM-2c) and the
# follow-up composer (LLM-3). The agent's own conversational turn (LLM-1) runs
# inside Dograh now, and is configured there.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_USE_MANAGED_IDENTITY=false
AZURE_DEPLOYMENT_AGENT=gpt-4o-broker
AZURE_DEPLOYMENT_ANALYZER=gpt-4o-analyzer
AZURE_DEPLOYMENT_COMPOSER=gpt-4o-mini-composer

# Dograh - the agent orchestrator. https://docs.dograh.com
#
# Dograh owns the call: the VoBiz carrier leg, Azure Speech in both directions,
# and the workflow that decides what the agent says. All three are configured
# in the Dograh dashboard, NOT here - this app holds no carrier key and no
# speech key.
#
#   DOGRAH_API_KEY        Settings -> API Keys in the Dograh dashboard
#   DOGRAH_WORKFLOW_UUID  the agent's UUID, not an API Trigger node's
#   DOGRAH_SHARED_SECRET  invent one, then set the same value as a custom
#                         header (X-Dograh-Secret) on the workflow's HTTP API
#                         tools and its webhook node. It is what stops a
#                         stranger booking viewings via /api/dograh/tools/*.
# Verify with: docker compose run --rm check-dograh +91XXXXXXXXXX
DOGRAH_API_BASE=https://app.dograh.com
DOGRAH_API_KEY=
DOGRAH_WORKFLOW_UUID=
DOGRAH_SHARED_SECRET=

# Optional: pin which of Dograh's telephony configurations and numbers to dial
# with. Leave unset and Dograh picks the first one ready for outbound.
# DOGRAH_TELEPHONY_CONFIGURATION_ID=
# DOGRAH_FROM_PHONE_NUMBER_ID=

# Where Dograh can reach this app, for its HTTP API tools and the completion
# webhook. A public HTTPS origin, no trailing slash. Only needed when Dograh
# cannot reach this host directly.
#   cloudflared tunnel --url http://localhost:5173
PUBLIC_BASE_URL=

# Outbound providers
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
EMAIL_API_KEY=

# Where the lead's side of a call happens.
#   dograh - a real call, orchestrated by Dograh: VoBiz carries it and Azure
#            Speech is its voice. Falls back to `mock` unless the four DOGRAH_
#            settings above are all filled in.
#   mock   - a scripted lead replayed from seed/scripts. Needs no Dograh
#            account at all, and is what the demo runs on.
# There is no third value.
CALL_TRANSPORT=mock

# Demo switches
MOCK_OUTBOUND=true
